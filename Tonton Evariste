<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Examen Interactif</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; padding: 20px; }
        .hidden { display: none; }
        .container { margin-top: 20px; }
        button { margin-top: 10px; }
        .timer { font-weight: bold; color: red; }
    </style>
</head>
<body>
    <h1>Examen Interactif</h1>
    <button id="adminBtn">Administrateur</button>
    <button id="clientBtn">Client</button>

    <div id="adminInterface" class="hidden">
        <h2>Interface Administrateur</h2>
        <input type="password" id="adminPassword" placeholder="Mot de passe">
        <button id="loginAdmin">Se connecter</button>
        <div class="container hidden" id="questionContainer">
            <h3>Envoyer une question</h3>
            <input type="text" id="question" placeholder="Entrez la question">
            <button id="sendQuestion">Envoyer</button>
            <div id="responsesContainer"></div>
            <button id="changePasswordBtn">Changer le mot de passe</button>
        </div>
    </div>

    <div id="clientInterface" class="hidden">
        <h2>Interface Client</h2>
        <input type="text" id="clientName" placeholder="Nom">
        <input type="text" id="clientSurname" placeholder="Post-nom">
        <input type="text" id="clientFirstName" placeholder="Prénom">
        <input type="text" id="clientPromotion" placeholder="Promotion">
        <input type="text" id="clientFaculty" placeholder="Faculté">
        <input type="text" id="clientDepartment" placeholder="Département">
        <button id="connectClient">Se connecter</button>
        <div class="container hidden" id="clientQuestionContainer">
            <h3>Question:</h3>
            <div id="questionDisplay"></div>
            <div class="timer" id="timerDisplay">90</div>
            <input type="text" id="clientResponse" placeholder="Votre réponse">
            <button id="sendResponse">Envoyer réponse</button>
        </div>
    </div>

    <script>
        const adminPassword = '2004';
        let currentQuestion = '';
        let timer;

        document.getElementById('adminBtn').onclick = () => {
            document.getElementById('adminInterface').classList.remove('hidden');
        };

        document.getElementById('loginAdmin').onclick = () => {
            const password = document.getElementById('adminPassword').value;
            if (password === adminPassword) {
                document.getElementById('questionContainer').classList.remove('hidden');
            } else {
                alert('Mot de passe incorrect');
            }
        };

        document.getElementById('sendQuestion').onclick = () => {
            const question = document.getElementById('question').value;
            currentQuestion = question;
            document.getElementById('questionDisplay').innerText = question;
            startTimer();
            document.getElementById('questionContainer').classList.add('hidden');
            document.getElementById('clientQuestionContainer').classList.remove('hidden');
            document.getElementById('clientResponse').value = '';
        };

        function startTimer() {
            let timeLeft = 90;
            document.getElementById('timerDisplay').innerText = timeLeft;
            timer = setInterval(() => {
                timeLeft--;
                document.getElementById('timerDisplay').innerText = timeLeft;
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    alert('Le temps est écoulé!');
                    document.getElementById('clientResponse').disabled = true;
                }
            }, 1000);
        }

        document.getElementById('clientBtn').onclick = () => {
            document.getElementById('clientInterface').classList.remove('hidden');
        };

        document.getElementById('connectClient').onclick = () => {
            document.getElementById('clientQuestionContainer').classList.remove('hidden');
        };

        document.getElementById('sendResponse').onclick = () => {
            const response = document.getElementById('clientResponse').value;
            if (currentQuestion) {
                clearInterval(timer);
                const adminResponses = document.getElementById('responsesContainer');
                const responseMessage = document.createElement('div');
                responseMessage.innerText = `Réponse: ${response} (Client: ${document.getElementById('clientName').value})`;
                adminResponses.appendChild(responseMessage);
                alert('Réponse envoyée!');
            } else {
                alert('Aucune question active.');
            }
        };

        document.getElementById('changePasswordBtn').onclick = () => {
            const oldPassword = prompt('Entrez l\'ancien mot de passe:');
            if (oldPassword === adminPassword) {
                const newPassword = prompt('Entrez le nouveau mot de passe:');
                if (newPassword) {
                    adminPassword = newPassword;
                    alert('Mot de passe changé!');
                }
            } else {
                alert('Ancien mot de passe incorrect.');
            }
        };
    </script>
</body>
</html>
